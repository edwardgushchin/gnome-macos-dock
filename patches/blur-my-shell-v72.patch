+
+    // Dash to Dock adds its top-level actor before its children have been
+    // allocated. Wait briefly for a usable dash instead of losing blur for
+    // the entire session when both extensions start at the same time.
+    try_blur_when_ready(dash_container) {
+        if (this.try_blur(dash_container) ||
+            this.pending_dash_retries.has(dash_container))
+            return;
+
+        let attempts = 0;
+        const source_id = GLib.timeout_add(
+            GLib.PRIORITY_DEFAULT,
+            DASH_READY_RETRY_INTERVAL,
+            () => {
+                attempts++;
+                if (!this.enabled || this.try_blur(dash_container) ||
+                    attempts >= DASH_READY_RETRY_LIMIT) {
+                    this.pending_dash_retries.delete(dash_container);
+                    return GLib.SOURCE_REMOVE;
+                }
+                return GLib.SOURCE_CONTINUE;
+            }
+        );
+        this.pending_dash_retries.set(dash_container, source_id);
     }
 
